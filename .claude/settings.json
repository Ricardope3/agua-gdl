{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git -C * status *)",
      "Bash(git -C * status)",
      "Bash(git -C * log *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * show *)",
      "Bash(./check.sh)",
      "Bash(scripts/check.sh)",
      "Bash(scripts/check.sh --quick)",
      "Bash(scripts/live.sh)",
      "Bash(python3 check_cites.py)",
      "Bash(python3 lint_context.py)",
      "Bash(python3 score_answers.py)",
      "Bash(python3 score_answers.py --moves)",
      "Bash(python3 evidence/refs.py check)",
      "Bash(python3 evidence/refs.py find *)",
      "Bash(python3 ~/agua-gdl-notes/scripts/plazos.py)",
      "Bash(python3 pipelines/publicaciones.py --check)",
      "Bash(python3 pipelines/promesas.py --check)",
      "Bash(python3 pipelines/fotos.py --check)",
      "Bash(python3 pipelines/fotos.py --pendientes)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__list_connected_browsers",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git -C * push:*)",
      "Bash(fly deploy:*)",
      "Bash(fly * deploy:*)",
      "Bash(flyctl deploy:*)",
      "Bash(flyctl * deploy:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/start.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/receipt.sh" }] }
    ]
  }
}
