DATABASE_URL=postgres://postgres:dev@localhost:55432/aguagdl?sslmode=disable
PUBLIC_BASE_URL=https://aguagdl.com
# WhatsApp is optional (Meta closed the account in Oct 2026): leave WA_TOKEN empty to run without it.
WA_TOKEN=            # System user token (Meta Business settings > System users)
WA_PHONE_NUMBER_ID=  # App Dashboard > WhatsApp > API Setup
WA_APP_SECRET=       # App Dashboard > App settings > Basic
WA_VERIFY_TOKEN=     # Any random string; paste the same one in the webhook settings
WA_GRAPH_VERSION=v24.0  # Use the version shown in API Setup's sample request
# WA_TEMPLATE=aviso_corte  # The nightly reminder's approved template
# WA_LANGUAGE=es_MX        # The approved templates' language code
REMINDERS_ENABLED=false
TG_TOKEN=            # Optional: Telegram bot token from @BotFather; turns Telegram on
TG_WEBHOOK_SECRET=   # Required with TG_TOKEN: openssl rand -hex 32 (A-Z a-z 0-9 _ - only)
TG_REMINDERS_ENABLED=false
HEARTBEAT_URL=       # Optional: healthchecks.io ping URL; /fail is appended on failures
# PORT=8080 DAILY_CAP=250 MONTHLY_CAP=5000 REMINDER_HOUR=20 are set in fly.toml
# CATCH_UP_UNTIL_HOUR=22  # A night's run is retried, or sent after a restart, until this hour (after REMINDER_HOUR, at most 23)
# MIN_REPORTS_SHOWN=10    # Reports or answers a zone or day needs before the API shows how they split (at least 1)
