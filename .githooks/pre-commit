#!/bin/sh
# Author identity and private folders (AGENTS.md, Rules).
# git var honours --author and GIT_AUTHOR_EMAIL/GIT_COMMITTER_EMAIL, not just user.email.
for who in AUTHOR COMMITTER; do
  email=$(git var "GIT_${who}_IDENT" | sed 's/.*<\(.*\)>.*/\1/')
  if [ "$email" != "soporte@aguagdl.com" ]; then
    echo "pre-commit: commit as soporte@aguagdl.com, not $email (git config user.email soporte@aguagdl.com)." >&2
    exit 1
  fi
done
private=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(research|\.agua-social)/')
if [ -n "$private" ]; then
  echo "pre-commit: research/ and .agua-social/ stay out of this public repo:" >&2
  echo "$private" >&2
  exit 1
fi
if git diff --cached --name-only | grep -qx AGENTS.md && [ "$(git show :AGENTS.md | wc -c)" -gt 10240 ]; then
  echo "pre-commit: AGENTS.md is over 10 KB; move area detail to .claude/rules/ instead." >&2
  exit 1
fi
# The /transparencia skill cites the law with line pins: they and their quotes are checked against the law files in
# the private research archive, and its unpinned citations may not grow (6 Nov audit: skill edits here skipped that
# check). Checks the staged version; in a worktree, uses the main checkout's research/.
skill=.claude/skills/transparencia/SKILL.md
if git diff --cached --name-only | grep -qx "$skill"; then
  checker=research/transparency/check_cites.py
  [ -f "$checker" ] || checker="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)/research/transparency/check_cites.py"
  if [ -f "$checker" ]; then
    tmpd=$(mktemp -d -t skill-cites.XXXXXX)
    git show ":$skill" > "$tmpd/SKILL.md"
    python3 "$checker" "$tmpd/SKILL.md" || { rm -rf "$tmpd"; echo "pre-commit: fix the skill's law pins ($checker)." >&2; exit 1; }
    rm -rf "$tmpd"
  else
    echo "pre-commit: no research/ archive found, so the skill's law pins weren't checked." >&2
  fi
fi
